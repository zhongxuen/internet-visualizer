# Internet Visualizer -- environment variables
#
# Everything in this product is SIMULATED by default and needs no configuration.
# The variables below only affect the phase-12 "Live mode" network diagnostics,
# which are the single place real network requests can originate.
#
# Copy to .env.local for local development. Never commit .env.local.

# DNS-over-HTTPS resolver used by /api/diagnostics/dns (must be an allowlisted
# public resolver; see src/core/net/guard.ts).
DOH_RESOLVER_URL="https://cloudflare-dns.com/dns-query"

# RDAP bootstrap service used by /api/diagnostics/rdap.
RDAP_BOOTSTRAP_URL="https://rdap.org"

# Token-bucket rate limit applied per client IP to /api/diagnostics/*.
DIAGNOSTICS_RATE_LIMIT_PER_MINUTE="10"

# Hard timeout (ms) for any outbound live request. Must stay <= 5000.
DIAGNOSTICS_TIMEOUT_MS="5000"
